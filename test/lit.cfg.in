import os
import subprocess
import lit.formats

config.name = 'Neura Dialect Tests'
config.test_format = lit.formats.ShTest(True)
config.suffixes = ['.mlir']
config.test_source_root = os.path.dirname(__file__)
config.test_exec_root = os.path.dirname(__file__)
config.excludes = ['samples', 'benchmark']

# Tool substitutions from CMake
config.substitutions.append(('mlir-neura-opt', '@MLIR_NEURA_OPT@'))
config.substitutions.append(('neura-interpreter', '@NEURA_INTERPRETER@'))
config.substitutions.append(('neura-compiler', '@NEURA_COMPILER@'))
config.substitutions.append(('FileCheck', '@FILECHECK@'))
config.substitutions.append(('mlir-opt', '@MLIR_OPT@'))
config.substitutions.append(('mlir-translate', '@MLIR_TRANSLATE@'))
config.substitutions.append(('llc', '@LLC@'))
config.substitutions.append(('clang', '@CLANG@'))
config.neura_python = '@NEURA_PYTHON_EXECUTABLE@'
config.substitutions.append(('%neura_python', config.neura_python))

# CP-SAT analytical mapping is an optional e2e dependency.  A configured
# interpreter keeps the test hermetic; machines without OR-Tools explicitly
# skip the analytical cases instead of accidentally using an arbitrary
# `python3` from PATH.
if subprocess.run([config.neura_python, '-c', 'import ortools'],
                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
    config.available_features.add('neura-ortools')
